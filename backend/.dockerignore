# Keeps the build context small and, more importantly, keeps secrets out of the
# image. Configuration comes from the host's environment: baking a .env into an
# image distributes it to anyone who can pull that image.
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# The suite drives a live API over HTTP, so it is not run from inside the
# production image.
tests/
requirements-dev.txt

*.md
.git/
.gitignore
