# Backend environment. Copy to `.env` and fill in.
#   cp .env.example .env
#
# MONGO_URL, DB_NAME, JWT_SECRET and EMERGENT_LLM_KEY are read at *module scope*
# in server.py via os.environ[...], so the app will not start if they are absent.
# RESEND_API_KEY and SENDER_EMAIL are read lazily inside the email helpers.

# --- Database ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=haulcheck

# --- Auth ---
# Sign HS256 session JWTs. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every issued token.
JWT_SECRET=change-me-generate-a-real-secret

# --- CORS ---
# Comma-separated list of allowed browser origins. `*` is rejected in any
# non-development environment because the API sends credentials.
CORS_ORIGINS=http://localhost:3000

# development | production. Outside development, CORS_ORIGINS must be explicit
# (no `*`) and the app refuses to start otherwise.
ENVIRONMENT=development

# Trust the X-Forwarded-For header for per-IP rate limiting. Enable ONLY when
# the app sits behind a proxy/load balancer that overwrites the header --
# otherwise a client could forge it and bypass the driver-code sweep limit.
# Leave unset for a directly-exposed service; the real TCP peer is used instead.
TRUST_PROXY_HEADERS=

# --- External services ---
# Storage, AI and email each sit behind a provider interface (backend/providers).
# Leaving a key blank selects that service's "null" provider: the app starts and
# the rest of it works, but that feature reports clearly that it is unconfigured.
# The startup log names the provider chosen for each.

# Emergent platform key. Powers object storage (attachments) and AI by default.
EMERGENT_LLM_KEY=

# Object storage: emergent (default) | s3 | null
STORAGE_PROVIDER=
# Only for STORAGE_PROVIDER=s3 (AWS, Cloudflare R2, MinIO, Backblaze):
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# AI: emergent (default) | anthropic | null
AI_PROVIDER=
# Only for AI_PROVIDER=anthropic. Unlike emergentintegrations (not on PyPI),
# the anthropic package installs anywhere, which makes AI testable locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email (Resend) ---
# Defect alerts, reminder digests, invitations, password resets, audit packs.
# Sending is best-effort: a failure is logged, never raised, so a defect is
# still recorded when the notification cannot be delivered.
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDER_EMAIL=noreply@example.com

# --- Google sign-in ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and set
# the authorised redirect URI to EXACTLY:
#     <your frontend origin>/auth/google/callback
# e.g. http://localhost:3000/auth/google/callback for local development.
# The frontend origin must also appear in CORS_ORIGINS above -- the same list is
# used to reject redirect URIs pointing at hosts this deployment does not serve.
# Leave both blank and the "Continue with Google" button is hidden entirely;
# email/password sign-in is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
