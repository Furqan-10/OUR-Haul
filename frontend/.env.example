# Frontend environment. Copy to `.env` and fill in.
#   cp .env.example .env
#
# Base URL of the API host WITHOUT the /api suffix -- lib/api.js appends it.
#   Local:      http://localhost:8000
#   Production: https://haulcheck-api.onrender.com
#
# This is compiled into the bundle at build time, not read at runtime, so
# changing it needs a redeploy of the frontend -- updating the variable alone
# does nothing.
#
# The value must also appear in the backend's CORS_ORIGINS, or the browser
# blocks every request with a CORS error that looks like the API is down.
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: enable the CRACO webpack health-check plugin (see craco.config.js).
# ENABLE_HEALTH_CHECK=true
